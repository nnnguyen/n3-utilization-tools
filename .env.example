# Copy this file to .env in the repo root and fill in real values.
# docker-compose.yml reads these to configure the backend container.
# Never commit .env.
# DATABASE_URL, PORT and NODE_ENV are set by docker-compose.yml itself.

# JWT used to sign the auth cookie (httpOnly) — required, no default.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Encrypts connection secrets (client secrets, refresh tokens) at rest:
# 32 random bytes in base64. Generate with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep a copy in a password manager: losing it means every connection must be
# re-entered. To rotate, move the old value to CREDENTIALS_KEY_PREVIOUS.
CREDENTIALS_KEY=
CREDENTIALS_KEY_PREVIOUS=
# true reads connections from the new Connection table (falls back to the old
# tables when a row is missing); false/empty = old tables. Rollback = unset it.
CONNECTIONS_READ=

# Public URL of the frontend, used for CORS.
FRONTEND_URL=http://localhost:3000

# Google OAuth 2.0 credentials (optional — leave blank to disable Google login).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# SMTP for transactional email (optional — defaults to smtp.gmail.com if unset).
MAIL_HOST=
MAIL_PORT=
MAIL_SECURE=
MAIL_USER=
MAIL_PASS=

# YouTube OAuth redirect used when an account connects YouTube — required to
# connect YouTube: <backend URL>/api/auth/youtube/callback.
# YOUTUBE_REDIRECT_URI is the older name, read when YOUTUBE_CALLBACK_URL is unset.
YOUTUBE_CALLBACK_URL=http://localhost:3001/api/auth/youtube/callback
YOUTUBE_REDIRECT_URI=

# Fallback YouTube credentials for accounts without their own (optional).
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# true (default) while the Google OAuth app is in Testing: tokens expire after
# 7 days and the app warns ahead of time. Set false once the app is published.
YOUTUBE_OAUTH_TESTING_MODE=
# Days after authorization to start the expiry warning (default 5).
YOUTUBE_TOKEN_WARN_AFTER_DAYS=
# Daily YouTube API quota (default 10000).
YOUTUBE_QUOTA_LIMIT=
# Size limit of a manual upload, in MB (default 2048).
YOUTUBE_MANUAL_UPLOAD_MAX_MB=

# Fallback Zoom Server-to-Server OAuth credentials (optional).
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Zoom webhook signature verification (optional but recommended in production).
ZOOM_WEBHOOK_SECRET_TOKEN=

# false turns off automatic sync retries and YouTube processing checks (default on).
SYNC_SCHEDULER_ENABLED=

# IP rate limiting (optional).
IP_RATE_LIMIT_WINDOW_MS=
IP_RATE_LIMIT_MAX_PER_WINDOW=
