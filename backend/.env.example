# Copy this file to .env and fill in real values. Never commit .env.

DATABASE_URL="postgresql://utilization_tools:utilization_tools@localhost:5434/utilization_tools?schema=public"

PORT=3001
NODE_ENV=development

# Comma-separated list of allowed origins for CORS.
# In production, set this to your Vercel URL (e.g., https://n3-utilization-tools.vercel.app)
FRONTEND_URL=http://localhost:3000

# JWT used to sign the auth cookie (httpOnly)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Google OAuth 2.0 credentials (see README for how to create these)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

CREDENTIALS_KEY=

# Product analytics (optional): PostHog project token and host
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
