// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String  @id @default(uuid())
  googleId  String? @unique
  email     String  @unique
  password  String?
  name      String?
  avatarUrl String?

  isEmailVerified      Boolean   @default(false)
  verificationToken    String?
  resetPasswordToken   String?
  resetPasswordExpires DateTime?

  // Email copies of in-app notifications (sent only when MAIL_* is configured)
  notifyEmailOnCompleted Boolean @default(true)
  notifyEmailOnFailed    Boolean @default(true)

  // Personalization (Settings → Personalization); defaults keep the original look
  themeStyle String @default("broadsheet") // 'broadsheet' | 'organic' | 'classic'
  themeMode  String @default("light") // 'light' | 'dark' | 'system'
  language   String @default("vi") // 'vi' | 'en'
  // Product analytics (docs/design/P2-8-posthog.md): null = not asked yet;
  // nothing is tracked until true
  analyticsConsent Boolean?

  // System administration (docs/design/P2-2-workspaces.md §6b)
  platformRole          String    @default("user") // 'user' | 'super_admin'
  isLocked              Boolean   @default(false) // locked accounts cannot sign in or call the API
  mustChangePassword    Boolean   @default(false) // only the change-password screen works until changed
  tempPasswordExpiresAt DateTime? // set with a temp password; cleared when the user sets their own

  createdAt              DateTime                    @default(now())
  topics                 Topic[]
  zoomConfig             ZoomConfig?
  zoomWorkflowSettings   ZoomWorkflowSettings?
  zoomSyncRules          ZoomSyncRule[]
  connections            Connection[]
  quotaUsages            QuotaUsage[]
  youtubeConfig          YoutubeConfig?
  youtubeQuotas          YoutubeQuotaUsage[]
  zoomSyncLogs           ZoomSyncLog[]
  notifications          Notification[]
  channelVideos          ChannelVideoCache[]
  youtubeMatchDismissals ZoomYoutubeMatchDismissal[]
}

model ZoomConfig {
  id                 String   @id @default(uuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId          String?
  clientId           String?
  clientSecret       String?
  webhookSecretToken String?
  isActive           Boolean  @default(false)
  updatedAt          DateTime @updatedAt
}

// Automation Workflow settings of the Zoom page. Auto-upload is off by
// default; the other defaults reproduce the behaviour from before they existed
// (private, fixed title). Keep in step with DEFAULT_WORKFLOW_SETTINGS.
model ZoomWorkflowSettings {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  autoUpload          Boolean  @default(false)
  titleTemplate       String   @default("Zoom Recording: {topic}")
  descriptionTemplate String   @default("Recorded on {date} {time}")
  privacyStatus       String   @default("private") // 'public' | 'unlisted' | 'private'
  playlistId          String?
  timeZone            String   @default("Asia/Ho_Chi_Minh") // for {date} and {time}
  // Captions from the Zoom transcript (docs/design/P2-5-captions.md)
  captionsEnabled     Boolean  @default(false)
  captionLanguage     String   @default("vi") // BCP-47, e.g. 'vi', 'en'
  captionName         String? // track name shown on YouTube
  updatedAt           DateTime @updatedAt
}

// Per-topic overrides of the workflow settings (first matching rule wins)
model ZoomSyncRule {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  position            Int
  matchText           String // matched against the meeting topic, ignoring case and accents
  titleTemplate       String?
  descriptionTemplate String?
  playlistId          String?
  tags                String[] @default([])
  privacyStatus       String? // 'public' | 'unlisted' | 'private'; ignored when publishDelayMinutes is set
  publishDelayMinutes Int? // upload private, YouTube publishes at recording end + delay
  captionLanguage     String? // overrides the workflow caption language
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId, position])
}

// One connection per app (provider) per account: replaces ZoomConfig /
// YoutubeConfig step by step (docs/design/P2-1-connector.md)
model Connection {
  id                  String    @id @default(uuid())
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider            String // 'youtube' | 'zoom' (connections/providers.ts)
  status              String    @default("active") // 'active' | 'disabled' | 'needs_reauth'
  externalAccountId   String? // Zoom account_id, YouTube channel id
  externalAccountName String?
  settings            Json      @default("{}") // non-secret: clientId, accountId…
  credentials         String? // secrets, encrypted by connections/credentials-cipher.ts
  state               Json      @default("{}") // provider bookkeeping (e.g. channelVideosFetchedAt)
  tokenObtainedAt     DateTime?
  lastTokenRefreshAt  DateTime?
  tokenInvalidAt      DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([userId, provider])
  @@index([provider, externalAccountId])
}

// API quota used per account, app and day (the provider's reset day)
model QuotaUsage {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider    String
  date        String // YYYY-MM-DD in the provider's reset time zone
  unitsUsed   Int      @default(0)
  lastUpdated DateTime @updatedAt

  @@unique([userId, provider, date])
}

// Who did what. workspaceId stays null for system-level (super admin) actions
// until workspaces exist (P2-2a).
model ActivityLog {
  id          String   @id @default(uuid())
  workspaceId String?
  actorId     String? // null = the system (webhook, retries, bootstrap)
  action      String // e.g. 'admin.user.created', 'admin.user.locked'
  targetType  String?
  targetId    String?
  data        Json?
  createdAt   DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([createdAt])
}

model YoutubeConfig {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId     String?
  clientSecret String?
  refreshToken String?
  isActive     Boolean  @default(false)
  updatedAt    DateTime @updatedAt

  tokenObtainedAt    DateTime? // When the current refresh token was issued (OAuth callback)
  lastTokenRefreshAt DateTime? // Last time the refresh token was successfully exchanged for an access token
  tokenInvalidAt     DateTime? // Set when Google rejected the refresh token (invalid_grant); cleared on re-authorize

  channelVideosFetchedAt DateTime? // Last successful refresh of ChannelVideoCache (null = never fetched)
}

enum SyncStatus {
  PENDING
  UPLOADING
  PROCESSING
  COMPLETED
  FAILED
}

model ZoomSyncLog {
  id                      String     @id @default(uuid())
  userId                  String
  user                    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  event                   String
  meeting                 String
  status                  String // Keeping old status for compatibility or migration
  syncStatus              SyncStatus @default(PENDING)
  progress                Int        @default(0)
  youtubeId               String?
  youtubeVideoId          String? // New field as per requirement
  youtubeProcessingStatus String? // New field for detailed processing status
  syncError               String?
  errorSource             String? // 'upload' | 'youtube_processing' | null
  errorCode               String? // Original error code from API
  errorMessage            String? // Original error message
  downloadUrl             String?
  playlistId              String? // Group 1: Playlist management
  playlistError           String? // Set when adding the video to the playlist failed (upload itself still succeeded)
  recordingStartTime      String? // Zoom start_time, kept so an auto-retry can re-run the sync
  privacyStatus           String? // Privacy chosen for the sync, reused by auto-retry
  autoRetryCount          Int        @default(0) // Automatic retries done since the last manual sync
  nextRetryAt             DateTime? // Set while an automatic retry is scheduled
  attemptCount            Int        @default(0) // Total sync attempts (manual + automatic), for stats
  failureCount            Int        @default(0) // Total failed attempts, for stats
  fileSize                BigInt? // Bytes of the uploaded Zoom MP4
  durationSeconds         Int? // Length of the uploaded Zoom MP4
  recordingId             String?    @unique
  syncStartedAt           DateTime?
  syncCompletedAt         DateTime?
  // Captions from the Zoom transcript (P2-5): 'waiting_transcript' | 'pending' |
  // 'uploaded' | 'failed' | 'no_transcript'; never changes syncStatus
  captionStatus           String?
  captionTrackId          String?
  captionError            String?
  captionErrorCode        String?
  captionAttempts         Int        @default(0)
  captionUpdatedAt        DateTime?
  publishAt               DateTime? // Scheduled publication (rule with a publish delay), reused by auto-retry
  source                  String     @default("upload") // 'upload' (synced by this app) | 'linked' (a video already on YouTube, linked by the user)
  createdAt               DateTime   @default(now())

  @@index([userId])
}

enum TopicStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum QuestionStatus {
  DRAFT // chưa mở, khán giả không thấy
  ACTIVE // đang nhận câu trả lời
  CLOSED // đã đóng, chỉ xem kết quả
}

enum QuestionType {
  WORD_CLOUD // hiện chỉ hỗ trợ loại này; để enum sẵn cho việc mở rộng sau
}

enum JoiningInfoType {
  QR_CODE
  LINK
  CODE
}

enum ResultVisibility {
  INSTANT // kết quả hiện ngay khi khán giả gửi
  ON_CLICK // presenter bấm mới hiện — tránh hiệu ứng bầy đàn (khuyến nghị)
  PRIVATE // không hiện trên màn hình chiếu, chỉ xem/export sau
}

model Topic {
  id                String      @id @default(uuid())
  ownerId           String
  owner             User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title             String
  description       String?
  code              String      @unique // mã tham gia, vd "AB12CD"
  status            TopicStatus @default(DRAFT)
  currentQuestionId String?     @unique // câu hỏi đang chiếu
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  questions         Question[]

  @@index([ownerId])
}

model Question {
  id        String         @id @default(uuid())
  topicId   String
  topic     Topic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  order     Int // thứ tự hiển thị, bắt đầu từ 1
  prompt    String // nội dung câu hỏi
  status    QuestionStatus @default(DRAFT)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  // ==== Cấu hình (mỗi câu hỏi cấu hình riêng) — bám theo panel Edit của Mentimeter ====
  type QuestionType @default(WORD_CLOUD)

  // --- Response settings ---
  responseLimit              Int? // null = KHÔNG GIỚI HẠN; có giá trị = số lượt tối đa/thiết bị
  maxWordLength              Int     @default(40) // độ dài tối đa 1 từ/cụm từ
  allowDuplicateFromSameUser Boolean @default(false) // 1 người gửi trùng từ có tính 2 lượt không

  // --- Design ---
  backgroundColor   String  @default("#FFFFFF")
  questionColor     String? // null = tự động chọn tương phản với backgroundColor
  textColorScheme   String  @default("default") // tên bảng màu chữ dùng cho word cloud
  showLogo          Boolean @default(true)
  logoUrl           String?
  maxWordsDisplayed Int     @default(50) // số từ hiển thị tối đa trên word cloud

  // --- Joining instructions ---
  showJoiningInfo Boolean         @default(true)
  joiningInfoType JoiningInfoType @default(QR_CODE)

  // --- Show responses ---
  resultVisibility      ResultVisibility @default(INSTANT)
  resultsRevealed       Boolean          @default(false) // dùng cho ON_CLICK: presenter đã bấm hiện chưa
  showResultsToAudience Boolean          @default(false) // (thêm ngoài Mentimeter) khán giả xem kết quả trên điện thoại

  responses      Response[]
  wordAggregates WordAggregate[]

  @@unique([topicId, order])
  @@index([topicId])
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String // 'sync_completed' | 'sync_failed'
  title       String
  message     String
  // Values to render title/message in the reader's language (null on rows
  // created before; title/message stay as the Vietnamese fallback)
  data        Json?
  link        String?
  recordingId String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId, read])
}

// Snapshot of every video on the connected channel (Channel Content → Videos),
// refreshed on demand or when older than an hour so page views cost no quota
model ChannelVideoCache {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId         String
  title           String
  thumbnail       String?
  privacyStatus   String?
  durationSeconds Int?
  viewCount       Int?
  likeCount       Int? // null when the owner hid likes
  commentCount    Int? // null when comments are disabled
  publishedAt     DateTime?
  zoomRecordingId String? // From the "Zoom recording ID:" line this app writes in the description of its uploads
  fetchedAt       DateTime  @default(now())

  @@unique([userId, videoId])
  @@index([userId])
}

// A suggested Zoom recording <-> YouTube video match the user rejected ("not this one")
model ZoomYoutubeMatchDismissal {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recordingId String
  videoId     String
  createdAt   DateTime @default(now())

  @@unique([userId, recordingId, videoId])
  @@index([userId])
}

model YoutubeQuotaUsage {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        String // Format: YYYY-MM-DD
  unitsUsed   Int      @default(0)
  lastUpdated DateTime @updatedAt

  @@unique([userId, date])
}

model Response {
  id                   String   @id @default(uuid())
  questionId           String
  question             Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  rawText              String // nguyên văn người dùng gõ
  normalizedText       String // đã chuẩn hoá theo mục 6
  participantSessionId String // UUID sinh ở client, lưu localStorage
  createdAt            DateTime @default(now())

  @@index([questionId, participantSessionId])
}

model WordAggregate {
  id             String   @id @default(uuid())
  questionId     String
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  normalizedText String
  displayText    String // giữ bản gõ đầu tiên để hiển thị
  count          Int      @default(1)

  @@unique([questionId, normalizedText])
  @@index([questionId, count])
}
