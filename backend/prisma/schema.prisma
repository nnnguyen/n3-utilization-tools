generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String                      @id @default(uuid())
  googleId               String?                     @unique
  email                  String                      @unique
  name                   String?
  avatarUrl              String?
  createdAt              DateTime                    @default(now())
  isEmailVerified        Boolean                     @default(false)
  password               String?
  resetPasswordExpires   DateTime?
  resetPasswordToken     String?
  verificationToken      String?
  notifyEmailOnCompleted Boolean                     @default(true)
  notifyEmailOnFailed    Boolean                     @default(true)
  language               String                      @default("vi")
  themeMode              String                      @default("light")
  themeStyle             String                      @default("broadsheet")
  isLocked               Boolean                     @default(false)
  mustChangePassword     Boolean                     @default(false)
  platformRole           String                      @default("user")
  tempPasswordExpiresAt  DateTime?
  analyticsConsent       Boolean?
  activeWorkspaceId      String?
  channelVideos          ChannelVideoCache[]
  connections            Connection[]
  memberships            Membership[]
  notifications          Notification[]
  quotaUsages            QuotaUsage[]
  topics                 Topic[]
  workflows              Workflow[]
  invitesAccepted        WorkspaceInvite[]           @relation("InvitesAccepted")
  invitesCreated         WorkspaceInvite[]           @relation("InvitesCreated")
  zoomSyncLogs           ZoomSyncLog[]
  zoomSyncRules          ZoomSyncRule[]
  zoomWorkflowSettings   ZoomWorkflowSettings?
  youtubeMatchDismissals ZoomYoutubeMatchDismissal[]
}

model Workspace {
  id               String                      @id @default(uuid())
  name             String
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  activityLogs     ActivityLog[]
  channelVideos    ChannelVideoCache[]
  connections      Connection[]
  dynamicQRs       DynamicQR[]
  members          Membership[]
  quotaUsages      QuotaUsage[]
  workflows        Workflow[]
  invites          WorkspaceInvite[]
  syncLogs         ZoomSyncLog[]
  syncRules        ZoomSyncRule[]
  workflowSettings ZoomWorkflowSettings?
  dismissals       ZoomYoutubeMatchDismissal[]
}

model Membership {
  workspaceId String
  userId      String
  role        String    @default("editor")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
}

model WorkspaceInvite {
  id           String    @id @default(uuid())
  workspaceId  String
  role         String    @default("editor")
  tokenHash    String    @unique
  createdById  String
  expiresAt    DateTime
  acceptedById String?
  acceptedAt   DateTime?
  createdAt    DateTime  @default(now())
  acceptedBy   User?     @relation("InvitesAccepted", fields: [acceptedById], references: [id])
  createdBy    User      @relation("InvitesCreated", fields: [createdById], references: [id], onDelete: Cascade)
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model ZoomWorkflowSettings {
  id                       String                 @id @default(uuid())
  userId                   String                 @unique
  autoUpload               Boolean                @default(false)
  titleTemplate            String                 @default("Zoom Recording: {topic}")
  descriptionTemplate      String                 @default("Recorded on {date} {time}")
  privacyStatus            String                 @default("private")
  playlistId               String?
  timeZone                 String                 @default("Asia/Ho_Chi_Minh")
  updatedAt                DateTime               @updatedAt
  captionLanguage          String                 @default("vi")
  captionName              String?
  captionsEnabled          Boolean                @default(false)
  driveBackupEnabled       Boolean                @default(false)
  driveFileTypes           String[]               @default(["MP4", "M4A", "TRANSCRIPT"])
  workspaceId              String?                @unique
  driveBackupTarget        DriveBackupDestination @default(GOOGLE_DRIVE)
  driveFolderId            String?
  driveFolderName          String?
  aiChaptersEnabled        Boolean                @default(false)
  aiSummaryEnabled         Boolean                @default(false)
  aiTitleEnabled           Boolean                @default(false)
  youtubePreferredFileType String                 @default("shared_screen_with_speaker_view")
  user                     User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace                Workspace?             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model DriveBackup {
  id          String                 @id @default(uuid())
  userId      String
  recordingId String
  fileType    String
  topic       String
  startTime   String
  fileName    String?
  bytes       BigInt?
  driveFileId String?
  folderId    String?
  uploadUrl   String?
  status      String
  errorCode   String?
  error       String?
  attempts    Int                    @default(0)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  destination DriveBackupDestination @default(GOOGLE_DRIVE)

  @@unique([recordingId, fileType, destination])
  @@index([userId, status])
}

model ZoomSyncRule {
  id                  String     @id @default(uuid())
  userId              String
  position            Int
  matchText           String
  titleTemplate       String?
  descriptionTemplate String?
  playlistId          String?
  tags                String[]   @default([])
  privacyStatus       String?
  publishDelayMinutes Int?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  captionLanguage     String?
  workspaceId         String?
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace           Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, position])
  @@index([workspaceId, position])
}

model Connection {
  id                  String     @id @default(uuid())
  userId              String
  provider            String
  status              String     @default("active")
  externalAccountId   String?
  externalAccountName String?
  settings            Json       @default("{}")
  credentials         String?
  state               Json       @default("{}")
  tokenObtainedAt     DateTime?
  lastTokenRefreshAt  DateTime?
  tokenInvalidAt      DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  workspaceId         String?
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace           Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, externalAccountId])
  @@unique([workspaceId, provider, externalAccountId])
  @@index([provider, externalAccountId])
}

model QuotaUsage {
  id          String     @id @default(uuid())
  userId      String
  provider    String
  date        String
  unitsUsed   Int        @default(0)
  lastUpdated DateTime   @updatedAt
  workspaceId String?
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, date])
  @@unique([workspaceId, provider, date])
}

model ActivityLog {
  id          String     @id @default(uuid())
  workspaceId String?
  actorId     String?
  action      String
  targetType  String?
  targetId    String?
  data        Json?
  createdAt   DateTime   @default(now())
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([createdAt])
}

model ZoomSyncLog {
  id                      String     @id @default(uuid())
  userId                  String
  event                   String
  meeting                 String
  status                  String
  youtubeId               String?
  createdAt               DateTime   @default(now())
  downloadUrl             String?
  recordingId             String?    @unique
  progress                Int        @default(0)
  syncCompletedAt         DateTime?
  syncError               String?
  syncStartedAt           DateTime?
  syncStatus              SyncStatus @default(PENDING)
  youtubeVideoId          String?
  youtubeProcessingStatus String?
  errorCode               String?
  errorMessage            String?
  errorSource             String?
  playlistId              String?
  playlistError           String?
  autoRetryCount          Int        @default(0)
  nextRetryAt             DateTime?
  privacyStatus           String?
  recordingStartTime      String?
  attemptCount            Int        @default(0)
  durationSeconds         Int?
  failureCount            Int        @default(0)
  fileSize                BigInt?
  source                  String     @default("upload")
  publishAt               DateTime?
  captionAttempts         Int        @default(0)
  captionError            String?
  captionErrorCode        String?
  captionStatus           String?
  captionTrackId          String?
  captionUpdatedAt        DateTime?
  workspaceId             String?
  aiChapters              String?
  aiSummary               String?
  aiTitle                 String?
  user                    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace               Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, recordingId])
  @@index([userId])
  @@index([workspaceId, createdAt])
}

model Topic {
  id                String      @id @default(uuid())
  ownerId           String
  title             String
  code              String      @unique
  status            TopicStatus @default(DRAFT)
  createdAt         DateTime    @default(now())
  currentQuestionId String?     @unique
  description       String?
  updatedAt         DateTime    @updatedAt
  questions         Question[]
  owner             User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

model Question {
  id                         String           @id @default(uuid())
  topicId                    String
  order                      Int
  prompt                     String
  status                     QuestionStatus   @default(DRAFT)
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt
  type                       QuestionType     @default(WORD_CLOUD)
  responseLimit              Int?
  maxWordLength              Int              @default(40)
  allowDuplicateFromSameUser Boolean          @default(false)
  backgroundColor            String           @default("#FFFFFF")
  textColorScheme            String           @default("default")
  showLogo                   Boolean          @default(true)
  maxWordsDisplayed          Int              @default(50)
  showJoiningInfo            Boolean          @default(true)
  joiningInfoType            JoiningInfoType  @default(QR_CODE)
  resultVisibility           ResultVisibility @default(INSTANT)
  resultsRevealed            Boolean          @default(false)
  showResultsToAudience      Boolean          @default(false)
  questionColor              String?
  logoUrl                    String?
  topic                      Topic            @relation(fields: [topicId], references: [id], onDelete: Cascade)
  responses                  Response[]
  wordAggregates             WordAggregate[]

  @@unique([topicId, order])
  @@index([topicId])
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  type        String
  title       String
  message     String
  link        String?
  recordingId String?
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  data        Json?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model ChannelVideoCache {
  id              String     @id @default(uuid())
  userId          String
  videoId         String
  title           String
  thumbnail       String?
  privacyStatus   String?
  durationSeconds Int?
  viewCount       Int?
  likeCount       Int?
  commentCount    Int?
  publishedAt     DateTime?
  fetchedAt       DateTime   @default(now())
  zoomRecordingId String?
  workspaceId     String?
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace       Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
  @@unique([workspaceId, videoId])
  @@index([userId])
  @@index([workspaceId])
}

model ZoomYoutubeMatchDismissal {
  id          String     @id @default(uuid())
  userId      String
  recordingId String
  videoId     String
  createdAt   DateTime   @default(now())
  workspaceId String?
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, recordingId, videoId])
  @@unique([workspaceId, recordingId, videoId])
  @@index([userId])
  @@index([workspaceId])
}

model Response {
  id                   String   @id @default(uuid())
  rawText              String
  normalizedText       String
  participantSessionId String
  createdAt            DateTime @default(now())
  questionId           String
  question             Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId, participantSessionId])
}

model WordAggregate {
  id             String   @id @default(uuid())
  normalizedText String
  displayText    String
  count          Int      @default(1)
  questionId     String
  question       Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, normalizedText])
  @@index([questionId, count])
}

model DynamicQR {
  id          String    @id @default(uuid())
  name        String?
  shortCode   String    @unique
  targetUrl   String
  workspaceId String
  scanCount   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model Workflow {
  id          String              @id @default(uuid())
  name        String
  description String?
  isActive    Boolean             @default(true)
  workspaceId String?
  userId      String
  trigger     String              @default("ZOOM_RECORDING_COMPLETED")
  config      Json                @default("{}")
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace?          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  executions  WorkflowExecution[]
  steps       WorkflowStep[]

  @@index([userId])
  @@index([workspaceId])
}

model WorkflowStep {
  id         String   @id @default(uuid())
  workflowId String
  type       String
  config     Json     @default("{}")
  position   Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
}

model WorkflowExecution {
  id          String    @id @default(uuid())
  workflowId  String
  recordingId String
  status      String
  results     Json      @default("{}")
  error       String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  workflow    Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([recordingId])
}

enum DriveBackupDestination {
  GOOGLE_DRIVE
  ONEDRIVE
}

enum SyncStatus {
  PENDING
  UPLOADING
  PROCESSING
  COMPLETED
  FAILED
  SKIPPED
}

enum TopicStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum QuestionStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum QuestionType {
  WORD_CLOUD
}

enum JoiningInfoType {
  QR_CODE
  LINK
  CODE
}

enum ResultVisibility {
  INSTANT
  ON_CLICK
  PRIVATE
}
